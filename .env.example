# ============================================================================
# MODÈLE de configuration — AUCUN SECRET RÉEL ICI.
# Copiez ce fichier en `.env` (ignoré par git) et remplacez les placeholders.
# ============================================================================

# --- Supabase ---
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
VITE_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_PUBLISHABLE_KEY=VOTRE_CLE_PUBLISHABLE_ICI
VITE_SUPABASE_PUBLISHABLE_KEY=VOTRE_CLE_PUBLISHABLE_ICI
# ⚠ service_role contourne TOUTE la RLS : serveur uniquement, jamais côté client,
# jamais dans git.
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE_ICI

# --- Fournisseurs IA / OCR ---
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL_ICI
GROQ_API_KEY=VOTRE_CLE_GROQ_ICI
GEMINI_API_KEY=VOTRE_CLE_GEMINI_ICI
DONUT_ENDPOINT=http://127.0.0.1:8501/parse
DONUT_TIMEOUT_MS=25000

# --- Envoi d'e-mails ---
# TROIS transports, essayés dans cet ordre :
#
#   1) API Resend (HTTPS/443) — LE TRANSPORT DE PRODUCTION. Railway, Render et
#      la plupart des hébergeurs FILTRENT le port SMTP sortant : un envoi en 587
#      y meurt en ENETUNREACH/ETIMEDOUT, et ni le mail d'approbation
#      d'inscription ni les relances de factures ne partent. Le 443 passe
#      toujours. Clé : https://resend.com/api-keys (commence par « re_ »).
RESEND_API_KEY=
#      Expéditeur. Laisser VIDE = bac à sable « Clarify <onboarding@resend.dev> »,
#      toujours accepté MAIS qui n'écrit QU'À l'adresse propriétaire du compte
#      Resend — suffisant pour tester l'approbation d'inscription, insuffisant
#      pour relancer de vrais clients. Pour cela : vérifier un domaine sur
#      https://resend.com/domains (SPF + DKIM), puis poser une adresse dessus.
# RESEND_FROM=Clarify <contact@votre-domaine.ma>
#
#   2) SMTP classique (nodemailer) — secours, et suffisant sur un réseau qui
#      laisse sortir le 587. Renseignez les 4 lignes SMTP_* puis REDÉMARREZ.
#      FROM_EMAIL doit être sur un domaine authentifié (SPF + DKIM + DMARC)
#      pour ne PAS tomber en spam.
#
#   3) API Brevo (HTTPS/443) — filet historique, optionnel.
#      ⚠ L'adresse FROM_EMAIL doit être un « sender » VALIDÉ dans le compte
#        Brevo, sinon l'API répond 400 (vérif : GET /v3/senders).
BREVO_API_KEY=
#
# MAIL_TRANSPORT — ORDRE des transports essayés, du principal au secours.
#   auto (défaut)  → resend, puis smtp, puis brevo
#   smtp           → SMTP seul (une valeur seule force ce transport)
#   smtp,resend    → SMTP principal, Resend en secours
# Quand poser « smtp,resend » : tant qu'aucun domaine n'est vérifié chez Resend,
# celui-ci refuse (403) tout destinataire autre que le propriétaire du compte.
# Le SMTP Gmail écrit à n'importe qui — à condition que l'hébergeur laisse sortir
# le port. Vérifiez-le AVANT de basculer :  GET /api/diag-mail?token=…&sonde=1
# MAIL_TRANSPORT=auto
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=VOTRE_UTILISATEUR_SMTP_ICI
SMTP_PASS=VOTRE_MOT_DE_PASSE_SMTP_ICI
# SMTP_SECURE=false
# SMTP_TLS_REJECT_UNAUTHORIZED=true
FROM_EMAIL=contact@votre-domaine.ma
FROM_NAME=HisabPro

# --- Abonnements & quotas de scans ---
# Fournisseur de paiement. 'manual' = pas de paiement en ligne : le plan choisi
# est activé immédiatement, le règlement se fait hors application.
# Brancher Stripe/CMI plus tard = implémenter le provider puis poser sa valeur ici.
BILLING_PROVIDER=manual
# Politique en cas de PANNE du quota (RPC injoignable, migration non appliquée) :
#   false (défaut) → on laisse passer le scan et on journalise (un incident
#                    d'infra ne doit pas couper le produit) ;
#   true           → on bloque le scan. À activer quand la facturation devient
#                    contraignante (offre payante réellement vendue).
QUOTA_STRICT=false

# --- File de traitement documentaire (BullMQ / Redis) ---
# REDIS_URL=redis://127.0.0.1:6379   # décommentez après `npm run redis:up` pour le mode QUEUE
WORKER_CONCURRENCY=4
JOB_TIMEOUT_MS=120000
JOB_MAX_ATTEMPTS=3

# --- Tests E2E (local uniquement) ---
E2E_EMAIL=VOTRE_EMAIL_DE_TEST_ICI
E2E_PASSWORD=VOTRE_MOT_DE_PASSE_DE_TEST_ICI
E2E_ICE=000000000000000

# ── Approbation des inscriptions par l'administrateur ────────────────────────
# Un compte créé naît NON approuvé : get_user_cabinet() ne lui rend aucun
# cabinet, donc la RLS ne lui laisse voir aucune donnee tant qu'un admin n'a pas
# clique le lien recu par mail. Migration : 20260716120000_approbation_inscription.sql
#
# Secret qui signe les liens d'approbation (HMAC). OBLIGATOIRE : sans lui, la
# route /api/approve-user refuse de fonctionner (echec ferme). Le changer
# invalide tous les liens deja envoyes. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_TOKEN_SECRET=

# Adresse qui recoit les demandes d'approbation.
ADMIN_APPROVAL_EMAIL=oussamakarmaoui7@gmail.com

# URL publique de l'app, pour construire un lien cliquable depuis l'e-mail.
# Sur Railway, RAILWAY_PUBLIC_DOMAIN est utilise automatiquement si APP_URL est
# vide. En local, laisser vide revient a http://localhost:3000.
APP_URL=

# Requis pour approuver (contourne la RLS). Deja necessaire ailleurs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Experience A/B : conversion en niveaux de gris des images de releves ──
# Uniquement la luminance (aucun contraste, aucune binarisation), resolution
# d'origine conservee. Defaut = false (flux couleur actuel).
# Bascule a chaud, sans rebuild : ?grayscale=1 dans l'URL, ou
# localStorage.setItem("bank_grayscale","1"). Gain mesure : ~3,7 % d'octets.
VITE_ENABLE_BANK_GRAYSCALE=false

# ══ FACTURATION ELECTRONIQUE (e-Invoicing DGI) ═══════════════════════════════
#
# Clef qui entre dans l'empreinte d'inalterabilite de chaque facture, aux cotes
# du numero, de la date, des deux ICE et du montant TTC. OBLIGATOIRE : sans
# elle, aucune facture ne peut etre scellee ni transmise (echec ferme, jamais
# de repli silencieux — une empreinte calculable par n'importe qui n'a aucune
# valeur probante).
#
# ATTENTION : la MEME valeur doit exister en local ET sur Railway. Une facture
# scellee avec une clef ne se verifie plus avec une autre, et la changer rend
# INVERIFIABLE tout l'historique deja emis. La choisir une fois, la sauvegarder.
# Generer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EFACTURE_SECRET_KEY=

# ── Acces plateforme DGI ─────────────────────────────────────────────────────
# Tant que DGI_API_URL et DGI_API_KEY sont VIDES, l'application utilise le bac
# a sable (MockDgiService) : les recepissus sont simules, l'interface le signale
# en permanence, et rien n'est reellement declare. Renseigner ces deux variables
# suffit a basculer sur la vraie plateforme — aucun changement de code.
DGI_API_URL=
DGI_API_KEY=

# Authentification mutuelle (mTLS), si la DGI l'exige a l'ouverture des acces.
DGI_CLIENT_CERT=
DGI_CLIENT_KEY=

# Delai d'attente des appels DGI, en millisecondes (defaut 30000).
DGI_TIMEOUT_MS=

# Latence simulee du bac a sable, en millisecondes (defaut 450). La garder non
# nulle en developpement : une reponse instantanee cache les defauts d'interface
# qui apparaissent des que l'attente est reelle.
DGI_MOCK_LATENCE_MS=
